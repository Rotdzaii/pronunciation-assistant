    "duration",
    "start_time",
    "end_time"
  ],
  "audio": {
    "sample_rate": 16000,
    "mono": true,
    "crop": "one second centered at (start_time + end_time) / 2 for every class",
    "samples": 16000,
    "boundary_policy": "clip available utterance audio and zero-pad only the missing side"
  },
  "log_mel": {
    "n_mels": 64,
    "n_fft": 2048,
    "hop_length": 512,
    "win_length": 2048,
    "window": "hann",
    "center": true,
    "pad_mode": "constant",
    "power": 2.0,
    "power_to_db_ref": "max",
    "top_db": 80.0,
    "mel_norm": "slaney (legacy librosa default)",
    "feature_shape": [
      1,
      64,
      32
    ]
  },
  "model": "SmallPronunciationCNNAttention",
  "backbone_channels": [
    16,
    32,
    64,
    96
  ],
  "head": {
    "dropout": 0.2,
    "linear": [
      96,
      2
    ]
  },
  "random_initialization": true,
  "loss": "class-weighted CrossEntropy",
  "class_weight_formula": "N / (2 * train_class_count[c])",
  "class_weights": {
    "correct": 0.5794941634241245,
    "incorrect": 3.6448849730788058
  },
  "sampler": "standard shuffled DataLoader",
  "augmentation": "none",
  "seed": 42,
  "batch_size": 8,
  "optimizer": "Adam",
  "learning_rate": 0.0001,
  "epochs": 12,
  "threshold": "argmax",
  "checkpoint_selection": "highest validation Macro-F1; tie higher incorrect F1; tie earlier epoch",
  "validation_thresholds": {
    "macro_f1": 0.6,
    "balanced_accuracy": 0.6,
    "incorrect_f1": 0.4,
    "incorrect_recall": 0.4,
    "substitution_recall": 0.4,
    "deletion_recall": 0.3
  },
  "duration_matched_test_thresholds": {
    "macro_f1": 0.55,
    "incorrect_f1": 0.35,
    "max_macro_f1_drop": 0.1,
    "max_incorrect_f1_drop": 0.1
  }
