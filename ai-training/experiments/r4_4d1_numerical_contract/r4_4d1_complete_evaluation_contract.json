  "ctc_score": {
    "selected_family": "RAW",
    "logits_shape_per_word": "[T,41]",
    "log_probs_equation": "log_probs = torch.log_softmax(logits, dim=-1)",
    "implementation": "torch.nn.CTCLoss",
    "parameters": {
      "blank": 40,
      "reduction": "none",
      "zero_infinity": true,
      "input_lengths": "[T]",
      "target_lengths": "[len(H)]"
    },
    "nll_equation": "NLL(H) = CTCLoss(log_probs, H, input_lengths=[T], target_lengths=[len(H)], blank=40, reduction='none', zero_infinity=True)",
    "raw_score_equation": "RAW_SCORE(H) = -NLL(H)",
    "empty_target": {
      "allowed": true,
      "implementation": "exact torch CTCLoss target_length=0 behavior",
      "finite_score_required": true,
      "failure_action": "stop future run; do not drop target or substitute a custom formula"
    },
    "forbidden": [
      "target_length_normalization",
      "encoder_time_normalization",
      "length_correction",
      "duration_correction",
      "phone_prior",
      "speaker_prior",
      "greedy_decode_omission_in_decision_score"
    ]
  },
  "local_hypotheses": {
    "expected_sequence": "E=[E0,...,E(n-1)]",
    "for_each_expected_position": true,
    "keep": "H_KEEP=E",
    "delete": "H_DELETE(i)=E with Ei removed",
    "substitution": "H_SUB(i,q)=E with Ei replaced by q for every canonical q != Ei",
    "substitution_hypotheses_per_position": 39,
    "manual_observed_phone_enters_scoring": false,
    "confusion_prior": false,
    "best_substitution": {
      "score_equation": "BEST_SUB_SCORE_i=max_{q != Ei} RAW_SCORE(H_SUB(i,q))",
      "phone_equation": "BEST_SUB_PHONE_i=argmax_{q != Ei} RAW_SCORE(H_SUB(i,q))",
      "exact_score_tie": "lowest canonical phone index",
      "canonical_phone_indices": "frozen R3/R4 ordering 0 through 39"
    }
  },
  "decision_score": {
    "keep": "KEEP_i=RAW_SCORE(H_KEEP)",
    "delete": "DELETE_i=RAW_SCORE(H_DELETE(i))",
    "substitution": "SUB_i=BEST_SUB_SCORE_i",
    "equation": "D_i=DELETE_i-max(KEEP_i,SUB_i)",
    "dtype": "float64",
    "only_scalar_for_deletion_calibration": true
  },
