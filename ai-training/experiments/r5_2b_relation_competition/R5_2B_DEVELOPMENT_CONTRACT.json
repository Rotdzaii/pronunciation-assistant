{
  "contract_id": "R5-2B_RELATION_COMPETITIVE_EXACT_CTC_TRAIN_DEVELOPMENT",
  "date": "2026-08-18",
  "contract_status": "R5_2B_DEVELOPMENT_CONTRACT_FROZEN",
  "purpose": "Freeze one TRAIN-only relation-competitive exact CTC development experiment before implementation, static verification, or inference.",
  "scientific_hypothesis": "An INSERT counts as addition evidence only to the extent that it outperforms the strongest KEEP, single-SUBSTITUTION, or single-DELETE non-addition explanation in the same alignability-safe TARGET-normalized exact CTC likelihood space.",
  "causal_mechanism": "Explicit SUB/DELETE alternatives may prevent a weak KEEP score in substitution/deletion words from creating spurious INSERT preference.",
  "nonclaim": "The hypothesis has not been evaluated and is not claimed to improve performance.",
  "authoritative_sources": {
    "r5_2a_manifest_sha256": "F8E476F8FFA6AB2CD0F833B17D667D0D9B6CE3FC6B9FA1A7F5C1A3D71BA753E1",
