  "score_contract": {
    "expected_sequence": "E=[e1,...,eN], N>=1",
    "vocabulary": "canonical indices 0..39; blank 40",
    "KEEP": "one target E",
    "INSERT": "40(N+1) targets E[:b]+[p]+E[b:]",
    "SUB": "39N targets replacing one expected phone with p != E[i]",
    "DELETE": "N targets removing one expected phone",
    "total_candidates": "80N+41",
    "nonempty_alignability": "T >= len(H) + ADJACENT_REPEAT_COUNT(H)",
    "nonempty_impossible_score": "negative infinity",
    "alignable_nonempty_raw": "-CTCLoss(log_softmax(logits),H,blank=40,reduction=none,zero_infinity=True)",
    "target_normalization": "RAW_SCORE(H)/max(len(H),1)",
    "empty_delete_raw": "sum over t of log_softmax(logits[t])[40]",
    "empty_delete_target": "RAW_SCORE([])",
    "best_nonaddition": "max(KEEP, BEST_SUB, BEST_DELETE) TARGET scores",
    "C": "TARGET_SCORE(BEST_INSERT)-BEST_NON_ADDITION_SCORE",
    "decision": "C >= theta means ADDITION; otherwise NON_ADDITION"
  },
  "tie_rules": {
    "BEST_INSERT": ["lower insertion boundary", "lower canonical phone index"],
    "BEST_SUB": ["lower expected-phone position", "lower replacement canonical phone index"],
    "BEST_DELETE": ["lower deleted expected-phone position"],
    "BEST_NON_ADDITION_family_diagnostic": ["KEEP", "SUB", "DELETE"],
    "family_priority_changes_numeric_maximum": false
  },
  "population": {
