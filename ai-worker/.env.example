SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NODE_WEBHOOK_URL=http://localhost:8000/practice/webhook/ai-result
AI_WEBHOOK_SECRET=replace-with-ai-webhook-secret
QUEUE_NAME=practice_jobs
WORKER_MODE=loop
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_IDLE_BACKOFF_MAX_SECONDS=10
SCORER_MODE=cnn_attention_context
ALIGNMENT_MODE=mfa
MODEL_VERSION=phoenix_v2_stable
MODEL_CONFIDENCE_THRESHOLD=0.65
CNN_ATTENTION_CONTEXT_CHECKPOINT_PATH=/absolute/local/path/to/l2_arctic_cnn_attention_context_0_10.pt
CNN_ATTENTION_CONTEXT_MODE=context_0_10
CNN_ATTENTION_CONTEXT_LEFT_SECONDS=0.10
CNN_ATTENTION_CONTEXT_RIGHT_SECONDS=0.10
# MFA runtime selection is explicit. Conda and WSL are mutually exclusive.
# The default demo uses the local Windows Conda environment.
MFA_RUNTIME=conda
MFA_COMMAND=mfa
MFA_CONDA_ENV=aligner
MFA_DICTIONARY_PATH=english_us_mfa
MFA_ACOUSTIC_MODEL_PATH=english_mfa
# Set MFA_RUNTIME=wsl only when WSL is intentionally provisioned. All three
# values below are then required. Leave them commented for the Conda runtime.
# MFA_WSL_DISTRO=Ubuntu
# MFA_WSL_USER=phoenix
# MFA_WSL_BINARY=/home/phoenix/miniforge3/envs/mfa/bin/mfa
MFA_TEMP_DIR=
MFA_ALIGNMENT_TIMEOUT_SECONDS=300
MFA_KEEP_DEBUG_ARTIFACTS=false
MFA_MIN_AUDIO_DURATION_SECONDS=0.1
MFA_MAX_AUDIO_DURATION_SECONDS=60
MFA_BOUNDARY_TOLERANCE_SECONDS=0.03
MFA_MIN_COVERAGE_RATIO=0.40
MFA_WARNING_COVERAGE_RATIO=0.65
MFA_MIN_WORD_COVERAGE_RATIO=0.60
MFA_VERY_SHORT_PHONE_SECONDS=0.015
MFA_VERY_LONG_PHONE_SECONDS=1.50
MFA_MAX_VERY_SHORT_PHONE_RATIO=0.25
ALLOW_ALIGNMENT_FALLBACK=true
