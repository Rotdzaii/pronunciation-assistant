SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NODE_WEBHOOK_URL=http://localhost:8000/practice/webhook/ai-result
AI_WEBHOOK_SECRET=replace-with-ai-webhook-secret
QUEUE_NAME=practice_jobs
# Stable Storage bucket used by worker queue messages. New jobs enqueue a
# storage path; the worker downloads it with service-role access at processing time.
PRACTICE_AUDIO_BUCKET=practice-audios
WORKER_MODE=loop
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_IDLE_BACKOFF_MAX_SECONDS=10
SCORER_MODE=cnn_attention_context
ALIGNMENT_MODE=mfa
MODEL_VERSION=phoenix_v2_stable
MODEL_CONFIDENCE_THRESHOLD=0.65
CNN_ATTENTION_CONTEXT_CHECKPOINT_PATH=/absolute/local/path/to/l2_arctic_cnn_attention_context_0_10.pt
CNN_ATTENTION_CONTEXT_MODE=context_0_10
CNN_ATTENTION_CONTEXT_LEFT_SECONDS=0.10
CNN_ATTENTION_CONTEXT_RIGHT_SECONDS=0.10
# The documented local demo uses the local Windows Conda environment.
MFA_RUNTIME=conda
MFA_COMMAND=mfa
MFA_CONDA_ENV=aligner
MFA_DICTIONARY_PATH=english_us_mfa
MFA_ACOUSTIC_MODEL_PATH=english_mfa
# The documented Windows workflow uses Conda. Do not switch to WSL for normal
# local setup.
MFA_TEMP_DIR=
MFA_ALIGNMENT_TIMEOUT_SECONDS=300
MFA_KEEP_DEBUG_ARTIFACTS=false
MFA_MIN_AUDIO_DURATION_SECONDS=0.1
MFA_MAX_AUDIO_DURATION_SECONDS=60
# Provisional VAD fallback for pitch-degraded speaker-to-mic recordings.
# This path is indeterminate, never confirmed speech: MFA must subsequently
# produce a usable TextGrid before CNN inference can run.
VAD_UNVOICED_ONLY_MIN_RATIO=0.10
VAD_UNVOICED_ONLY_MIN_RUN_SECONDS=0.30
VAD_UNVOICED_ONLY_MAX_GAP_SECONDS=0.12
MFA_BOUNDARY_TOLERANCE_SECONDS=0.03
# Raw phone coverage over the full recording. Kept for compatibility and warnings only.
MFA_MIN_COVERAGE_RATIO=0.40
MFA_WARNING_COVERAGE_RATIO=0.65
# Hard phone-union/aligned-span fill gate, independent of leading/trailing silence.
# The environment-variable name is retained for backward compatibility; it is not VAD speech coverage.
MFA_MIN_SPEECH_COVERAGE_RATIO=0.70
MFA_MIN_ALIGNED_DURATION_SECONDS=0.12
MFA_MAX_BOUNDARY_SILENCE_SECONDS=0.50
MFA_MIN_WORD_COVERAGE_RATIO=0.60
MFA_VERY_SHORT_PHONE_SECONDS=0.015
MFA_VERY_LONG_PHONE_SECONDS=1.50
MFA_MAX_VERY_SHORT_PHONE_RATIO=0.25
ALLOW_ALIGNMENT_FALLBACK=true
