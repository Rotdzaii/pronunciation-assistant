APP_NAME="AI Pronunciation Diagnosis API"
APP_VERSION="0.1.0"
APP_ENV="development"
BACKEND_CORS_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:3000"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
AI_WEBHOOK_SECRET=replace-with-ai-webhook-secret
PRACTICE_AUDIO_BUCKET=practice-audios
PRONUNCIATION_AUDIO_BUCKET=pronunciation-audio
# Set to true only during development when new vocabulary words need on-the-fly
# fetching before the next download_audio.py run. False = demo mode (manifest only).
ENABLE_LIVE_PRONUNCIATION_FALLBACK=false
